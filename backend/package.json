{
  "name": "naporta-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de pedidos Na Porta",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "prisma generate --schema ../database/prisma/schema.prisma && tsc --noEmit -p tsconfig.json",
    "build": "prisma generate --schema ../database/prisma/schema.prisma && tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
