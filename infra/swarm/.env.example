# Exportar manualmente no shell. Docker stack não lê .env automaticamente.
# Substituir por imagens verificadas e publicadas por digest.
NGINX_IMAGE=nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
BACKEND_IMAGE=registry.example.com/naporta/backend@sha256:SUBSTITUIR
API_REPLICAS=2
STACK_NAME=naporta
JWT_ISSUER=naporta
